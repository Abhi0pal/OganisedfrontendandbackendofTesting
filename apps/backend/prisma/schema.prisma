  display_order      Int                      @default(0) @map("display_order")
  parent_master_code String?                  @map("parent_master_code") @db.VarChar(50)
  created_by         BigInt                   @map("created_by")
  created_at         DateTime                 @default(now()) @map("created_at")
  updated_at         DateTime                 @updatedAt @map("updated_at")
  columns            MasterColumnDefinition[]
  data               MasterData[]
  createdBy          users                    @relation("MasterDefinitionCreatedBy", fields: [created_by], references: [id])

  @@unique([tenant_id, code])
  @@map("master_definition")
}

model MasterColumnDefinition {
  id            Int                  @id @default(autoincrement())
  master_id     Int                  @map("master_id")
  column_key    String               @db.VarChar(50)
  column_label  String               @db.VarChar(100)
  data_type     MasterColumnDataType @map("data_type")
  is_required   Boolean              @default(false) @map("is_required")
  is_unique     Boolean              @default(false) @map("is_unique")
  is_searchable Boolean              @default(false) @map("is_searchable")
  is_listable   Boolean              @default(true) @map("is_listable")
  is_filterable Boolean              @default(false) @map("is_filterable")
  display_order Int                  @default(0) @map("display_order")
  options       Json?
  validation    Json?
  default_value String?              @map("default_value") @db.VarChar(255)
  placeholder   String?              @db.VarChar(255)
  master        MasterDefinition     @relation(fields: [master_id], references: [id], onDelete: Cascade)

  @@unique([master_id, column_key])
  @@map("master_column_definition")
}

model MasterData {
  id                 BigInt                @id @default(autoincrement())
  uid                String                @unique @default(uuid()) @db.VarChar(100)
  code               String                @db.VarChar(100)
  master_id          Int                   @map("master_id")
  tenant_id          Int?                  @map("tenant_id")
  data               Json
  is_active          Boolean               @default(true) @map("is_active")
  created_by         BigInt?               @map("created_by")
  updated_by         BigInt?               @map("updated_by")
  created_at         DateTime              @default(now()) @map("created_at")
  updated_at         DateTime              @updatedAt @map("updated_at")
  createdBy          users?                @relation("MasterDataCreatedBy", fields: [created_by], references: [id])
  master             MasterDefinition      @relation(fields: [master_id], references: [id], onDelete: Cascade)
  updatedBy          users?                @relation("MasterDataUpdatedBy", fields: [updated_by], references: [id])
  referencesFrom     MasterDataReference[] @relation("FromData")
  referencesTo       MasterDataReference[] @relation("ToData")
  usersDepartment    users[]               @relation("UserDepartment")
  usersSubDepartment users[]               @relation("UserSubDepartment")

  @@index([master_id, is_active])
  @@index([master_id, tenant_id])
  @@map("master_data")
}

model MasterDataReference {
  id           BigInt     @id @default(autoincrement())
  from_data_id BigInt     @map("from_data_id")
  to_data_id   BigInt     @map("to_data_id")
  column_key   String     @map("column_key") @db.VarChar(50)
  fromData     MasterData @relation("FromData", fields: [from_data_id], references: [id], onDelete: Cascade)
  toData       MasterData @relation("ToData", fields: [to_data_id], references: [id], onDelete: Cascade)

  @@unique([from_data_id, to_data_id, column_key])
  @@index([from_data_id])
  @@index([to_data_id])
  @@map("master_data_reference")
}

model WorkflowDefinition {
  id              Int                      @id @default(autoincrement())
  uid             String                   @unique @default(uuid()) @db.VarChar(36)
  tenantId        Int                      @map("tenant_id")
  departmentId    Int                      @map("department_id")
  subDepartmentId Int?                     @map("sub_department_id")
  serviceId       String?                  @map("service_id") @db.VarChar(20)
  projectId       Int?                     @map("project_id")
  moduleId        Int?                     @map("module_id")
  code            String                   @db.VarChar(50)
  name            String                   @db.VarChar(200)
  description     String?
  version         Int                      @default(1)
  status          WorkflowDefinitionStatus @default(DRAFT)
  createdBy       BigInt?                  @map("created_by")
  updatedBy       BigInt?                  @map("updated_by")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  forwardLevels   TWorkflowForwardLevel[]
  module          Module?                  @relation("WfDefModule", fields: [moduleId], references: [id])
  project         TenantProject?           @relation("WfDefProject", fields: [projectId], references: [id])
  service         Service?                 @relation("WfDefService", fields: [serviceId], references: [service_id])
  subDepartment   SubDepartment?           @relation("WfDefSubDept", fields: [subDepartmentId], references: [id])
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  forkJoins       WorkflowForkJoin[]
  processes       WorkflowProcess[]

  @@unique([tenantId, departmentId, code, version])
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
  @@index([tenantId, departmentId, subDepartmentId])
  @@index([serviceId])
  @@map("wf_definitions")
}

model WorkflowProcess {
  id                   Int                       @id @default(autoincrement())
  uid                  String                    @unique @default(uuid()) @db.VarChar(36)
  workflowDefId        Int                       @map("workflow_def_id")
  processCode          String                    @db.VarChar(20)
  stepOrder            Int                       @map("step_order")
  name                 String                    @db.VarChar(200)
  description          String?
  nodeType             ProcessNodeType           @default(STANDARD)
  assigneeType         AssigneeType              @default(ROLE)
  roleId               Int?                      @map("role_id")
  userId               BigInt?                   @map("user_id")
  slaHours             Int                       @default(0) @map("sla_hours")
  slaBreachAction      SlaBreach                 @default(NONE) @map("sla_breach_action")
  positionX            Float                     @default(0) @map("position_x")
  positionY            Float                     @default(0) @map("position_y")
  canVerifyDocument    Boolean                   @default(false) @map("can_verify_document")
  canRevertToApplicant Boolean                   @default(false) @map("can_revert_to_applicant")
  formTypeId           Int?                      @map("form_type_id")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  forwardLevels        TWorkflowForwardLevel[]
  fieldPermissions     WorkflowFieldPermission[]
  forkBranches         WorkflowForkJoinBranch[]
  forkJoinsAsFork      WorkflowForkJoin[]        @relation("ForkProcess")
  forkJoinsAsJoin      WorkflowForkJoin[]        @relation("JoinProcess")
  actions              WorkflowProcessAction[]
  formType             FormType?                 @relation("WfProcessFormType", fields: [formTypeId], references: [id])
  role                 roles?                    @relation("WfProcessRole", fields: [roleId], references: [id])
  user                 users?                    @relation("WfProcessUser", fields: [userId], references: [id])
  workflowDef          WorkflowDefinition        @relation(fields: [workflowDefId], references: [id], onDelete: Cascade)
  outgoingTransitions  WorkflowTransition[]      @relation("TransitionSource")
  incomingTransitions  WorkflowTransition[]      @relation("TransitionTarget")

  @@unique([workflowDefId, processCode])
  @@index([workflowDefId, stepOrder])
  @@map("wf_processes")
}

model WorkflowProcessAction {
  id               Int                  @id @default(autoincrement())
  uid              String               @unique @default(uuid()) @db.VarChar(36)
  processId        Int                  @map("process_id")
  actionCode       String               @db.VarChar(30)
  actionLabel      String               @db.VarChar(100)
  requiresComment  Boolean              @default(false) @map("requires_comment")
  requiresDocument Boolean              @default(false) @map("requires_document")
  requiresReason   Boolean              @default(false) @map("requires_reason")
  displayOrder     Int                  @default(0) @map("display_order")
  createdAt        DateTime             @default(now()) @map("created_at")
  process          WorkflowProcess      @relation(fields: [processId], references: [id], onDelete: Cascade)
  transitions      WorkflowTransition[]

  @@unique([processId, actionCode])
  @@map("wf_process_actions")
}

model WorkflowTransition {
  id              Int                   @id @default(autoincrement())
  uid             String                @unique @default(uuid()) @db.VarChar(36)
  sourceProcessId Int                   @map("source_process_id")
  targetProcessId Int                   @map("target_process_id")
  actionId        Int                   @map("action_id")
  conditionJson   Json?                 @map("condition_json")
  conditionLabel  String?               @map("condition_label") @db.VarChar(100)
  priority        Int                   @default(0)
  label           String?               @db.VarChar(100)
  createdAt       DateTime              @default(now()) @map("created_at")
  action          WorkflowProcessAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  sourceProcess   WorkflowProcess       @relation("TransitionSource", fields: [sourceProcessId], references: [id], onDelete: Cascade)
  targetProcess   WorkflowProcess       @relation("TransitionTarget", fields: [targetProcessId], references: [id], onDelete: Cascade)

  @@unique([sourceProcessId, actionId, priority])
  @@index([sourceProcessId])
  @@index([targetProcessId])
  @@map("wf_transitions")
}

model WorkflowForkJoin {
  id            Int                      @id @default(autoincrement())
  uid           String                   @unique @default(uuid()) @db.VarChar(36)
  workflowDefId Int                      @map("workflow_def_id")
  forkProcessId Int                      @map("fork_process_id")
  joinProcessId Int                      @map("join_process_id")
  joinStrategy  String                   @default("ALL") @db.VarChar(20)
  createdAt     DateTime                 @default(now()) @map("created_at")
  branches      WorkflowForkJoinBranch[]
  forkProcess   WorkflowProcess          @relation("ForkProcess", fields: [forkProcessId], references: [id])
  joinProcess   WorkflowProcess          @relation("JoinProcess", fields: [joinProcessId], references: [id])
  workflowDef   WorkflowDefinition       @relation(fields: [workflowDefId], references: [id], onDelete: Cascade)

  @@unique([workflowDefId, forkProcessId])
  @@map("wf_fork_joins")
}

model WorkflowForkJoinBranch {
  id              Int              @id @default(autoincrement())
  uid             String           @unique @default(uuid()) @db.VarChar(36)
  forkJoinId      Int              @map("fork_join_id")
  branchProcessId Int              @map("branch_process_id")
  branchLabel     String?          @db.VarChar(100)
  branchOrder     Int              @default(0) @map("branch_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  branchProcess   WorkflowProcess  @relation(fields: [branchProcessId], references: [id])
  forkJoin        WorkflowForkJoin @relation(fields: [forkJoinId], references: [id], onDelete: Cascade)

  @@unique([forkJoinId, branchProcessId])
  @@map("wf_fork_join_branches")
}

model TWorkflowForwardLevel {
  id                 BigInt                 @id @default(autoincrement())
  uid                String                 @unique @default(uuid()) @db.VarChar(36)
  workflowDefId      Int?                   @map("workflow_def_id")
  tenantId           Int                    @map("tenant_id")
  departmentId       Int                    @map("department_id")
  applicationId      BigInt                 @map("application_id")
  currentProcessId   Int?                   @map("current_process_id")
  forwardLevel       Int                    @default(1) @map("forward_level")
  currentRoleId      Int?                   @map("current_role_id")
  activeProcessIds   Json                   @default("[]") @map("active_process_ids")
  status             String                 @default("ACTIVE") @db.VarChar(20)
  orphanReason       String?                @map("orphan_reason") @db.VarChar(50)
  startedAt          DateTime               @default(now()) @map("started_at")
  completedAt        DateTime?              @map("completed_at")
  dueAt              DateTime?              @map("due_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  configId           Int?                   @map("config_id")
  currentProcessCode String?                @map("current_process_code") @db.VarChar(20)
  currentProcessName String?                @map("current_process_name") @db.VarChar(200)
  auditLogs          TWorkflowAudit[]
  configuration      WorkflowConfiguration? @relation(fields: [configId], references: [id])
  process            WorkflowProcess?       @relation(fields: [currentProcessId], references: [id], onDelete: Cascade)
  role               roles?                 @relation("WfForwardLevelRole", fields: [currentRoleId], references: [id])
  workflowDef        WorkflowDefinition?    @relation(fields: [workflowDefId], references: [id])

  @@index([applicationId])
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
  @@index([configId])
  @@map("t_workflow_forward_level")
}

model TWorkflowAudit {
  id               BigInt                @id @default(autoincrement())
  uid              String                @unique @default(uuid()) @db.VarChar(36)
  forwardLevelId   BigInt                @map("forward_level_id")
  fromProcessId    Int?                  @map("from_process_id")
  toProcessId      Int?                  @map("to_process_id")
  actionCode       String                @map("action_code") @db.VarChar(30)
  actorUserId      BigInt                @map("actor_user_id")
  actorRoleId      Int?                  @map("actor_role_id")
  remarks          String?
  payload          Json?
  ipAddress        String?               @map("ip_address") @db.VarChar(45)
  userAgent        String?               @map("user_agent") @db.VarChar(512)
  conditionMatched String?               @map("condition_matched") @db.VarChar(200)
  createdAt        DateTime              @default(now()) @map("created_at")
  fromProcessCode  String?               @map("from_process_code") @db.VarChar(20)
  fromProcessName  String?               @map("from_process_name") @db.VarChar(200)
  toProcessCode    String?               @map("to_process_code") @db.VarChar(20)
  toProcessName    String?               @map("to_process_name") @db.VarChar(200)
  forwardLevel     TWorkflowForwardLevel @relation(fields: [forwardLevelId], references: [id], onDelete: Cascade)

  @@index([forwardLevelId])
  @@index([actorUserId])
  @@map("t_workflow_forward_audit")
}

model WorkflowFieldPermission {
