generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                       BigInt               @id @default(autoincrement())
  uid                      String               @unique @default(uuid()) @db.VarChar(100)
  email                    String               @db.VarChar(255)
  password_hash            String?              @map("password_hash")
  salt                     String?              @db.VarChar(255)
  password_algo            String               @default("argon2") @db.VarChar(50)
  user_type                user_type            @default(INVESTOR)
  role_id                  Int?
  tenant_id                Int?
  project_id               Int?
  department_id            BigInt?
  sub_department_id        BigInt?
  is_email_verified        Int                  @default(0) @db.SmallInt
  is_active                Boolean              @default(true)
  last_login_at            DateTime?            @db.Timestamptz(6)
  deleted_at               DateTime?            @db.Timestamptz(6)
  created_at               DateTime             @default(now())
  updated_at               DateTime             @updatedAt
  investorDocuments        InvestorDocument[]
  department_user          department_users?
  investor_profile         investor_profiles?
  masterDataCreated        MasterData[]         @relation("MasterDataCreatedBy")
  masterDataUpdated        MasterData[]         @relation("MasterDataUpdatedBy")
  masterDefinitionsCreated MasterDefinition[]   @relation("MasterDefinitionCreatedBy")
  thirdPartyInspector      ThirdPartyInspector?
  user_logs                user_logs[]
  assignments              UserRoleAssignment[]
  external_auth_sessions   external_auth_sessions[]
  user_tokens              user_tokens[]
  department               MasterData?          @relation("UserDepartment", fields: [department_id], references: [id])
  project                  TenantProject?       @relation(fields: [project_id], references: [id])
  role                     roles?               @relation(fields: [role_id], references: [id])
  subDepartment            MasterData?          @relation("UserSubDepartment", fields: [sub_department_id], references: [id])
  tenant                   Tenant?              @relation(fields: [tenant_id], references: [id])
  workflowProcesses        WorkflowProcess[]    @relation("WfProcessUser")

  @@map("users")
}

model Country {
  id            Int      @id @default(autoincrement())
  name          String
  abbreviation  String?
  boCountryId   Int?
  lrId          Int?
  hadbastNumber Int?
  vtcCode       Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  states        State[]

  @@map("m_countries")
}

model user_logs {
  id          BigInt        @id @default(autoincrement())
  user_id     BigInt?
  user_type   user_type
  email       String?       @db.VarChar(255)
  log_type    user_log_type
  description String?
  ip_address  String?       @db.VarChar(45)
  user_agent  String?       @db.VarChar(512)
  session_id  String?       @db.VarChar(128)
  token_id    BigInt?
  metadata    Json?
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  token       user_tokens?  @relation(fields: [token_id], references: [id])
  user        users?        @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "idx_user_logs_user_id")
  @@index([log_type], map: "idx_user_logs_log_type")
  @@index([created_at], map: "idx_user_logs_created_at")
  @@map("user_logs")
}

model State {
  id           Int              @id @default(autoincrement())
  name         String
  abbreviation String?
  countryId    Int
  boStateId    Int?
  boLgdId      Int?
  stateCode    Int?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  blocks       Block[]
  districts    District[]
  documents    DocumentMaster[]
  country      Country          @relation(fields: [countryId], references: [id], onDelete: Cascade)
  tehsils      Tehsil[]

  @@map("m_states")
}

model District {
  id           Int      @id @default(autoincrement())
  name         String
  stateCode    String?  @db.VarChar(255)
  districtCode String?  @db.VarChar(255)
  stateId      Int
  abbreviation String?  @db.VarChar(255)
  latlong      String?  @db.VarChar(255)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  blocks       Block[]
  state        State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  tehsils      Tehsil[]

  @@map("m_districts")
}

model Block {
  id               Int                       @id @default(autoincrement())
  name             String
  districtId       Int
  stateId          Int
  unitCategory     String?                   @db.VarChar(10)
  districtCode     String?                   @db.VarChar(255)
  lgCodeDistrictId Int?
  isActive         Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  district         District                  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  state            State                     @relation(fields: [stateId], references: [id], onDelete: Cascade)
  kyiIcCalculators KyiIcCalculator[]
  regionMappings   MappingRegionCategories[]

  @@map("m_blocks")
}

model Tehsil {
  id              Int       @id @default(autoincrement())
  name            String
  districtId      Int
  stateId         Int
  subDistrictCode String?
  deptDivisionId  Int?
  lgDistrictId    Int?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  district        District  @relation(fields: [districtId], references: [id])
  state           State     @relation(fields: [stateId], references: [id])
  villages        Village[]

  @@map("m_tehsils")
}

model Village {
  id              Int      @id @default(autoincrement())
  name            String
  tehsilId        Int
  villageCode     String
  subDistrictCode String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tehsil          Tehsil   @relation(fields: [tehsilId], references: [id])

  @@map("m_villages")
}

model Department {
  id                Int                                @id @default(autoincrement())
  name              String
  uniqueTag         String                             @unique
  ip                String
  secretKey         String
  baseUrl           String
  publicKey         String
  abbreviation      String
  boDeptId          Int?
  order             Int?
  icon              String?
  deptType          Int                                @default(2)
  tenant_id         Int?
  isActive          Boolean                            @default(true)
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt
  issuerId          Int?
  workflowConfigs   ApplicationWorkflowConfiguration[]
  actMappings       ActPolicyNotificationDepartment[]
  issuer            Issuer?                            @relation(fields: [issuerId], references: [id])
  tenant            Tenant?                            @relation(fields: [tenant_id], references: [id])
  documentMasters   DocumentMaster[]
  investorDocuments InvestorDocument[]
  kyiIcCalculators  KyiIcCalculator[]
  policies          policy_master[]
  subDepartments    SubDepartment[]

  @@map("m_departments")
}

model Issuer {
  id                Int                @id @default(autoincrement())
  name              String
  isIssuerActive    Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  investorDocuments InvestorDocument[]
  departments       Department[]
  documentMasters   DocumentMaster[]
  services          Service[]

  @@map("m_issuers")
}

model DocumentType {
  id                Int                @id @default(autoincrement())
  uid               String?            @unique @default(uuid()) @db.VarChar(100)
  name              String
  abbreviation      String
  isDocActive       Boolean            @default(true)
  isFormatRequired  Boolean?
  tenant_id         Int?
  tenant_project_id Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  investorDocuments InvestorDocument[]
  documentMasters   DocumentMaster[]
  tenant            Tenant?            @relation(fields: [tenant_id], references: [id])
  tenantProject     TenantProject?     @relation(fields: [tenant_project_id], references: [id])

  @@index([tenant_id])
  @@index([tenant_project_id])
  @@map("m_documenttypes")
}

model FormType {
  id                Int                                @id @default(autoincrement())
  name              String
  abbr              String                             @unique
  isActive          Boolean                            @default(true)
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt
  workflowConfigs   ApplicationWorkflowConfiguration[]
  workflowProcesses WorkflowProcess[]                  @relation("WfProcessFormType")

  @@map("m_fb_form_types")
}

model FormCategory {
  id           Int            @id @default(autoincrement())
  uid          String?        @unique @default(uuid()) @db.VarChar(100)
  categoryName String         @map("category_name")
  nameInHindi  String?        @map("name_in_hindi")
  nameAlt      String?        @map("name")
  parentId     Int            @default(0) @map("parent_id")
  categoryCode String         @unique @map("category_code")
  isActive     Boolean        @default(true) @map("is_active")
  created      DateTime?      @map("created")
  modified     DateTime?      @map("modified")
  tenantId     Int?           @map("tenant_id")
  projectId    Int?           @map("project_id")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  project      TenantProject? @relation(fields: [projectId], references: [id])
  tenant       Tenant?        @relation(fields: [tenantId], references: [id])
  fields       FormField[]

  @@index([parentId])
  @@index([tenantId])
  @@index([projectId])
  @@map("m_fb_form_categories")
}

model FormField {
  id                Int                @id @default(autoincrement())
  uid               String?            @unique @default(uuid()) @db.VarChar(100)
  formCheckId       String             @unique @map("formchk_id")
  parentId          Int                @default(0) @map("parent_id")
  categoryId        Int?               @map("category_id")
  name              String
  nameInHindi       String?            @map("name_in_hindi")
  isEditable        String             @default("Y") @map("is_editable")
  createdDate       DateTime?          @map("created_date")
  isActive          Boolean            @default(true) @map("is_formvar_active")
  tenantId          Int?               @map("tenant_id")
  projectId         Int?               @map("project_id")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  formBuilderFields FormBuilderField[]
  category          FormCategory?      @relation(fields: [categoryId], references: [id])
  project           TenantProject?     @relation(fields: [projectId], references: [id])
  tenant            Tenant?            @relation(fields: [tenantId], references: [id])

  @@index([parentId])
  @@index([tenantId])
  @@index([projectId])
  @@map("m_fb_form_field")
}

model FormMapping {
  id            Int            @id @default(autoincrement())
  department_id Int
  service_id    String         @db.VarChar(10)
  form_type_id  Int
  form_name     String         @db.VarChar(255)
  form_code     String         @db.VarChar(255)
  form_version  String?        @db.VarChar(10)
  is_active     YnFlag         @default(Y)
  created       DateTime?
  modified      DateTime?
  project_id    Int?
  role_id       Int?
  tenant_id     Int?
  user_id       Int?
  project       TenantProject? @relation(fields: [project_id], references: [id])
  role          roles?         @relation(fields: [role_id], references: [id])
  service       Service        @relation("ServiceToFormMapping", fields: [service_id], references: [service_id])
  tenant        Tenant?        @relation(fields: [tenant_id], references: [id])

  @@unique([department_id, service_id, form_type_id, tenant_id, project_id, role_id, user_id], name: "uniq_formmapping_context")
  @@index([department_id])
  @@map("m_fb_form_mapping")
}

model FormPageMaster {
  id            Int       @id @default(autoincrement())
  service_id    String    @db.VarChar(255)
  page_name     String    @db.VarChar(255)
  is_active     YnFlag    @default(Y)
  name_in_hindi String?   @db.VarChar(255)
  preference    Int
  form_id       Int
  form_code     String?   @db.VarChar(250)
  created       DateTime?
  modified      DateTime?
  uid           String?   @unique @default(uuid()) @db.VarChar(100)
  tenantId      Int?      @map("tenant_id")
  projectId     Int?      @map("project_id")
  role_id       Int?

  @@index([form_id])
  @@map("m_fb_page_master")
}

model FormPageCategoryMapping {
  id          Int     @id @default(autoincrement())
  page_id     Int
  category_id Int
  preference  Int
  help_text   String? @db.VarChar(500)
  is_active   YnFlag  @default(Y)

  @@index([page_id])
  @@map("m_fb_page_category_mapping")
}

model FormBuilderField {
  id                    Int                       @id @default(autoincrement())
  uid                   String?                   @unique @default(uuid()) @db.VarChar(100)
  service_id            String
  form_id               Int
  page_id               Int
  category_id           Int
  form_field_id         Int
  preference            Int
  input_type            String
  custom_label          String?
  help_text             String?
  placeholder           String?
  gridSpan              Int                       @default(12) @map("grid_span")
  layoutType            String?                   @map("layout_type")
  component_props       Json?                     @map("component_props")
  is_required           YnFlag                    @default(N)
  is_editable           YnFlag                    @default(Y)
  is_readonly           YnFlag                    @default(N)
  is_active             YnFlag                    @default(Y)
  min_length            Int?
  max_length            Int?
  pattern               String?
  step                  String?
  row_type              String?
  validation_rule       Json?
  created               DateTime                  @default(now())
  modified              DateTime?
  project_id            Int?
  role_id               Int?
  tenant_id             Int?
  user_id               Int?
  formAddMoreColumns    FormAddMoreColumn[]
  addMoreGroups         FormAddMoreGroup[]        @relation("TriggerBuilderField")
  formField             FormField                 @relation(fields: [form_field_id], references: [id], onDelete: Cascade)
  project               TenantProject?            @relation(fields: [project_id], references: [id])
  role                  roles?                    @relation(fields: [role_id], references: [id])
  tenant                Tenant?                   @relation(fields: [tenant_id], references: [id])
  optionConfig          FormFieldOptionConfig?    @relation("BuilderFieldOptionConfig")
  optionConfigsAsParent FormFieldOptionConfig[]   @relation("OptionParent")
  fieldPermissions      WorkflowFieldPermission[]

  @@index([service_id, form_id, page_id, category_id])
  @@map("m_fb_form_builder_fields")
}

model FormFieldOptionConfig {
  id                      Int               @id @default(autoincrement())
  uid                     String?           @unique @default(uuid()) @db.VarChar(100)
  builder_field_id        Int               @unique
  source_type             OptionSourceType
  master_table_id         Int?
  static_options          Json?
  parent_builder_field_id Int?
  is_active               YnFlag            @default(Y)
  created                 DateTime          @default(now())
  modified                DateTime?
  builderField            FormBuilderField  @relation("BuilderFieldOptionConfig", fields: [builder_field_id], references: [id], onDelete: Cascade)
  parentBuilderField      FormBuilderField? @relation("OptionParent", fields: [parent_builder_field_id], references: [id])

  @@map("m_fb_formfield_options")
}

model FormBuilderConfigValue {
  id        Int     @id @default(autoincrement())
  useFor    String? @map("use_for") @db.VarChar(255)
  fieldCode String? @map("field_code") @db.VarChar(255)
  tableName String? @map("table_name") @db.VarChar(255)
  serviceId String  @default("0") @map("service_id") @db.Char(20)
  rawQuery  String? @map("raw_query")
  isActive  String  @default("t") @map("isActive") @db.Char(1)

  @@index([serviceId, isActive])
  @@index([useFor])
  @@map("m_fb_config_values")
}

model FormAddMoreGroup {
  id                       Int                 @id @default(autoincrement())
  service_id               String
  form_id                  Int
  page_id                  Int
  category_id              Int
  trigger_builder_field_id Int
  label                    String?
  min_rows                 Int?                @default(1)
  max_rows                 Int?
  is_active                YnFlag              @default(Y)
  created                  DateTime            @default(now())
  modified                 DateTime?
  columns                  FormAddMoreColumn[]
  triggerBuilderField      FormBuilderField    @relation("TriggerBuilderField", fields: [trigger_builder_field_id], references: [id], onDelete: Cascade)

  @@unique([service_id, form_id, page_id, category_id, trigger_builder_field_id], map: "uniq_addmore_group_scope")
  @@index([service_id, form_id, page_id, category_id])
  @@map("m_fb_addmore_groups")
}

model FormAddMoreColumn {
  id               Int              @id @default(autoincrement())
  group_id         Int
  builder_field_id Int
  col_order        Int
  builderField     FormBuilderField @relation(fields: [builder_field_id], references: [id])
  group            FormAddMoreGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([group_id, builder_field_id], map: "uniq_addmore_column")
  @@index([group_id])
  @@map("m_fb_addmore_columns")
}

model FormRule {
  id         Int       @id @default(autoincrement())
  service_id String
  form_id    Int
  scope      String
  when_json  Json
  then_json  Json
  is_active  YnFlag    @default(Y)
  created    DateTime  @default(now())
  modified   DateTime?

  @@index([service_id, form_id])
  @@map("m_fb_form_rules")
}

model DocumentCheckpoint {
  id                Int            @id @default(autoincrement())
  uid               String?        @unique @default(uuid()) @db.VarChar(100)
  name              String
  code              String         @unique
  isActive          Boolean        @default(true)
  created           DateTime?
  modified          DateTime?
  filePath          String?
  tenant_id         Int?
  tenant_project_id Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tenant            Tenant?        @relation(fields: [tenant_id], references: [id])
  tenantProject     TenantProject? @relation(fields: [tenant_project_id], references: [id])

  @@index([tenant_id])
  @@index([tenant_project_id])
  @@map("m_document_checkpoints")
}

model DocumentMaster {
  id                           Int                @id @default(autoincrement())
  uid                          String?            @unique @default(uuid()) @db.VarChar(100)
  checklistId                  String             @unique
  stateId                      Int
  issuerId                     Int
  departmentId                 Int
  documentTypeId               Int?
  issuerById                   Int?
  tenant_id                    Int?
  tenant_project_id            Int?
  checklistDocumentName        String
  checklistDocumentExtension   String
  checklistDocumentMaxSize     Int
  prescribedDocumentPath       String?
  services                     Int[]              @default([])
  documentCheckpoints          Int[]              @default([])
  isMultiVersionAllowed        Boolean            @default(false)
  isDocValidityRequired        Boolean            @default(false)
  isDocReferenceNumberRequired Boolean            @default(false)
  isAutoInsertAllowed          Boolean            @default(false)
  isDocActive                  Boolean            @default(true)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  investorDocuments            InvestorDocument[]
  department                   Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  documentType                 DocumentType?      @relation(fields: [documentTypeId], references: [id])
  issuer                       Issuer             @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  state                        State              @relation(fields: [stateId], references: [id], onDelete: Cascade)
  tenant                       Tenant?            @relation(fields: [tenant_id], references: [id])
  tenantProject                TenantProject?     @relation(fields: [tenant_project_id], references: [id])

  @@index([stateId])
  @@index([issuerId])
  @@index([departmentId])
  @@index([documentTypeId])
  @@index([createdAt])
  @@index([isDocActive])
  @@index([tenant_id])
  @@index([tenant_project_id])
  @@map("m_document_master")
}

model investor_profiles {
  id                 BigInt             @id @default(autoincrement())
  uid                String             @unique @db.VarChar(255)
  user_id            BigInt             @unique
  username           String?            @db.VarChar(255)
  first_name         String             @db.VarChar(255)
  last_name          String?            @db.VarChar(64)
  gender             String?            @db.VarChar(32)
  pan_card           String?            @db.VarChar(16)
  adhaar_number      String?            @db.VarChar(12)
  country_name       String             @db.VarChar(64)
  state_name         String             @db.VarChar(64)
  city_name          String             @db.VarChar(64)
  district_name      String             @db.VarChar(100)
  pin_code           String             @db.VarChar(10)
  address            String
  mobile_number      BigInt
  legal_entity_name  String?            @db.VarChar(255)
  cons_pan_card      String?            @db.VarChar(255)
  cons_first_name    String?            @db.VarChar(255)
  cons_last_name     String?            @db.VarChar(255)
  cons_mobile_number String?            @db.VarChar(255)
  cons_email         String?            @db.VarChar(255)
  cons_country_name  String?            @db.VarChar(255)
  cons_state_name    String?            @db.VarChar(255)
  date_of_birth      DateTime?          @db.Date
  project_id         String?
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @default(now()) @db.Timestamptz(6)
  investorDocuments  InvestorDocument[]
  user               users              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("investor_profiles")
}

model department_users {
  id                      BigInt   @id @default(autoincrement())
  user_id                 BigInt   @unique
  full_name               String   @db.VarChar(60)
  hindi_full_name         String?  @db.VarChar(255)
  email                   String   @db.VarChar(128)
  office_no               String?  @db.VarChar(15)
  mobile                  String?  @db.VarChar(16)
  dept_id                 Int
  district_id             Int?
  tahsil_id               Int      @default(0)
  circle_id               String?  @db.VarChar(255)
  block_id                Int      @default(0)
  office_id               Int      @default(0)
  division_id             Int      @default(0)
  delegate_officer_number String?  @db.VarChar(16)
  delegate_officer_name   String?  @db.VarChar(255)
  delegate_officer_email  String?  @db.VarChar(255)
  np_user_id              String?  @db.VarChar(255)
  is_for_testing          Int      @default(0) @db.SmallInt
  status                  Int      @default(1) @db.SmallInt
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @default(now()) @db.Timestamptz(6)
  user                    users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("department_users")
}

model user_tokens {
  id         BigInt          @id @default(autoincrement())
  user_id    BigInt
  token_hash String          @unique @db.VarChar(128)
  token_type user_token_type
  expires_at DateTime        @db.Timestamptz(6)
  used_at    DateTime?       @db.Timestamptz(6)
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  logs       user_logs[]
  user       users           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_tokens")
}

model external_auth_sessions {
  id                       BigInt    @id @default(autoincrement())
  user_id                  BigInt
  provider                 String    @db.VarChar(50)
  external_username        String?   @db.VarChar(255)
  access_token             String?   @db.Text
  refresh_token            String?   @db.Text
  token_type               String?   @db.VarChar(50)
  scope                    String?   @db.VarChar(255)
  access_token_expires_at  DateTime? @db.Timestamptz(6)
  refresh_token_expires_at DateTime? @db.Timestamptz(6)
  last_validated_at        DateTime? @db.Timestamptz(6)
  revoked_at               DateTime? @db.Timestamptz(6)
  raw_token_payload        Json?
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @updatedAt @db.Timestamptz(6)
  user                     users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, provider], map: "uq_external_auth_sessions_user_provider")
  @@index([provider], map: "idx_external_auth_sessions_provider")
  @@index([external_username], map: "idx_external_auth_sessions_external_username")
  @@map("external_auth_sessions")
}

model roles {
  id                Int                       @id @default(autoincrement())
  uid               String                    @unique @default(uuid()) @db.VarChar(100)
  name              String                    @db.VarChar(255)
  tenant_id         Int?
